# D2NACO — Dynamic and Diverse Neural ACO
# .gitignore: track core method code, ignore everything generated or auxiliary.

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
env/
venv/
.venv/
.tox/
*.egg-info/
*.dist-info/
*.egg
build/
dist/
bdist.*/
temp.linux-*/
lib/

# ── Caches & coverage ───────────────────────────────────────────────────
.cache
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.hypothesis/
.ipynb_checkpoints/

# ── C++ backend build artifacts ─────────────────────────────────────────
src/build/
src/.cache/
src/*.so
src/*.pyd
src/ngfaco.egg-info/

# ── Experiment outputs & artifacts (not core methods) ───────────────────
experiments/
output/
logs/
results/
results_extended/
tuning_results/
search_results/
visualizations/
tmp_models/
wandb/

# ── Model checkpoints (large binaries) ──────────────────────────────────
pretrained/
checkpoints/
checkpoints_extended/

# ── Runtime-generated data (keep curated benchmarks in data/) ───────────
data/generated/
data/cache/
data_old/
pretrained_old/
reviewer_experiments/

# ── Paper, notes & auxiliary docs (not code) ────────────────────────────
paper/
figures/
*.tex
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
dynaco_journal.pdf
srr_training_progress.pdf
srr_training_progress.png
rebuttal_results.csv
PROSE.md
polynet.md
survey.md
results.md
vram.md
explorer_plan.md
PLAN.MD

# ── All dotfiles / editor / agent state (keep only .gitignore) ──────────
.*
!.gitignore
!.python-version

# ── External reference implementations (not our core method) ────────────
references/

# ── Core dumps & OS files ───────────────────────────────────────────────
gpucore.*
core.*
*.core
.DS_Store
*.swp
*.swo
*~
