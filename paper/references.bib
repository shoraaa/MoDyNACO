   journal = {Engineering Applications of Artificial Intelligence},
   keywords = {3-opt,Ant colony optimization,Dynamic hybrid mechanism,Fuzzy system,Parameter adaptation,Particle swarm optimization},
   month = {9},
   pages = {105139},
   publisher = {Pergamon},
   title = {Parameter adaptation-based ant colony optimization with dynamic hybrid mechanism},
   volume = {114},
   year = {2022}
